# Example Hermes profile .env for Nous-Girl. Copy to ~/.hermes/profiles/YOUR_PROFILE/.env and fill in.
# Never commit the real file. Only the names are shown here; every value is a placeholder.

# The key the voice server uses to call Hermes' OpenAI-compatible API server (docs/HERMES.md).
API_SERVER_KEY=MAKE_UP_A_LONG_RANDOM_KEY

# stackchan-tools: must equal hg_bridge.token in the voice server's data/.config.yaml.
HG_BRIDGE_TOKEN=MAKE_UP_A_LONG_RANDOM_TOKEN

# agentmail and email-meme: your own AgentMail API key.
AGENTMAIL_API_KEY=YOUR_AGENTMAIL_API_KEY

# multilingual (only if Phonon runs from this shell): token for the gated Phonon 40M models.
# HF_TOKEN=YOUR_HUGGING_FACE_TOKEN
